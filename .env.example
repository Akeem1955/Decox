# ==========================================
# CATERX ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Database (PostgreSQL / Cloud SQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caterx?schema=public"

# 2. Google Gemini & Agent Framework
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"

# 3. Python Google ADK Agent Microservice
AGENT_SERVICE_URL="http://localhost:8000"

# 4. Web Extraction (Parallel.ai)
PARALLEL_API_KEY="your-parallel-api-key"

# 5. Outbound Email Dispatch (Resend / SMTP)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="CaterX Dispatch <dispatch@caterx.estate>"

# 6. Next.js App Public Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="caterx-super-secret-jwt-key"
